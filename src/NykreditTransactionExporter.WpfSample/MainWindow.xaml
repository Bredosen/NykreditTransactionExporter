<Window x:Class="NykreditTransactionExporter.WpfSample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nykredit Transaction Exporter"
        Width="1320"
        Height="860"
        MinWidth="1040"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid Margin="16,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Foreground="White"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Text="Nykredit Data" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#94A3B8"
                               FontSize="12"
                               Text="Open Banking workspace" />
                </StackPanel>

                <ListBox x:Name="NavigationListBox"
                         Grid.Row="2"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="NavigationListBox_SelectionChanged">
                    <ListBoxItem Tag="overview" Style="{StaticResource NavItemStyle}" Content="Overview" />
                    <ListBoxItem Tag="accounts" Style="{StaticResource NavItemStyle}" Content="Accounts" />
                    <ListBoxItem Tag="transactions" Style="{StaticResource NavItemStyle}" Content="Transactions" />
                    <ListBoxItem Tag="watcher" Style="{StaticResource NavItemStyle}" Content="Watcher" />
                    <ListBoxItem Tag="data" Style="{StaticResource NavItemStyle}" Content="Data explorer" />
                </ListBox>

                <Border Grid.Row="3"
                        Padding="12"
                        Background="#172033"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Foreground="#94A3B8"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Text="LOCAL API" />
                        <TextBox x:Name="ApiUrlTextBox"
                                 Margin="0,7,0,8"
                                 Padding="8,6"
                                 Background="#111827"
                                 Foreground="White"
                                 BorderBrush="#334155"
                                 Text="https://localhost:53682/"
                                 AutomationProperties.Name="Local API URL" />
                        <Button x:Name="ConnectButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ConnectButton_Click"
                                Content="Connect" />
                        <TextBlock x:Name="ConnectionDetailTextBlock"
                                   Margin="0,9,0,0"
                                   Foreground="#94A3B8"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="Not connected" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28,22,28,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="3" />
                <RowDefinition Height="15" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageTitleTextBlock"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Text="Overview" />
                    <TextBlock x:Name="PageSubtitleTextBlock"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Session, accounts and recent activity." />
                </StackPanel>

                <Border x:Name="ConnectionStatusBorder"
                        Grid.Column="1"
                        Margin="0,1,12,0"
                        Padding="11,7"
                        VerticalAlignment="Top"
                        Background="{StaticResource WarningSurfaceBrush}"
                        CornerRadius="8">
                    <TextBlock x:Name="ConnectionStatusTextBlock"
                               Foreground="{StaticResource WarningBrush}"
                               FontWeight="SemiBold"
                               Text="Offline" />
                </Border>
                <Button x:Name="AuthorizeButton"
                        Grid.Column="2"
                        Margin="0,0,8,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="AuthorizeButton_Click"
                        Content="Authorize"
                        IsEnabled="False" />
                <Button x:Name="RefreshButton"
                        Grid.Column="3"
                        VerticalAlignment="Top"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RefreshButton_Click"
                        Content="Refresh" />
            </Grid>

            <ProgressBar x:Name="BusyProgressBar"
                         Grid.Row="2"
                         IsIndeterminate="True"
                         Visibility="Collapsed" />

            <ContentControl x:Name="ContentHost" Grid.Row="4" />

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           Text="Local-only API" />
                <TextBlock x:Name="LastActivityTextBlock"
                           Grid.Column="1"
                           Margin="18,0,0,0"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Text="Ready" />
            </Grid>
        </Grid>
    </Grid>
</Window>
