<UserControl x:Class="NykreditTransactionExporter.WpfSample.Views.Accounts.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Accounts" />
                <TextBlock Grid.Row="1"
                           Margin="0,3,0,12"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Select an account to inspect its bank data." />
                <ListBox x:Name="AccountListBox"
                         Grid.Row="2"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="AccountListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,7">
                                <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="{Binding Iban}" />
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="{Binding Currency}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="AccountTitleTextBlock"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="Select an account" />
                        <TextBlock x:Name="AccountSubtitleTextBlock"
                                   Margin="0,4,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="Account metadata will appear here." />
                    </StackPanel>
                    <Button x:Name="LoadDetailsButton"
                            Grid.Column="1"
                            Margin="14,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="LoadDetailsButton_Click"
                            Content="Load details" />
                    <Button x:Name="LoadBalancesButton"
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="LoadBalancesButton_Click"
                            Content="Load balances" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <TabControl BorderThickness="0" Background="Transparent">
                    <TabItem Header="Account details">
                        <Grid Margin="0,12,0,0">
                            <TextBox x:Name="DetailsJsonTextBox"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     VerticalContentAlignment="Top"
                         TextWrapping="NoWrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="Select an account and load details." />
                        </Grid>
                    </TabItem>
                    <TabItem Header="Balances">
                        <Grid Margin="0,12,0,0">
                            <TextBox x:Name="BalancesJsonTextBox"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     VerticalContentAlignment="Top"
                         TextWrapping="NoWrap"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="Select an account and load balances." />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
