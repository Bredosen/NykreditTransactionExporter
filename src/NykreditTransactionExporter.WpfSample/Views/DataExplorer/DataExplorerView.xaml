<UserControl x:Class="NykreditTransactionExporter.WpfSample.Views.DataExplorer.DataExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="DATA SOURCE" />
                    <ComboBox x:Name="DataSourceComboBox"
                              Margin="0,5,0,0"
                              SelectionChanged="DataSourceComboBox_SelectionChanged">
                        <ComboBoxItem Content="Application metadata" Tag="application" IsSelected="True" />
                        <ComboBoxItem Content="ASPSP / bank metadata" Tag="aspsps" />
                        <ComboBoxItem Content="Raw current session" Tag="session" />
                        <ComboBoxItem Content="Authorization response" Tag="authorization" />
                        <ComboBoxItem Content="Account details" Tag="account-details" />
                        <ComboBoxItem Content="Account balances" Tag="account-balances" />
                    </ComboBox>
                </StackPanel>

                <StackPanel x:Name="AccountOptionsPanel" Grid.Column="2" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="ACCOUNT" />
                    <ComboBox x:Name="AccountComboBox" Margin="0,5,0,0" />
                </StackPanel>

                <Grid x:Name="AspspOptionsPanel" Grid.Column="2" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="COUNTRY" />
                        <TextBox x:Name="CountryTextBox" Margin="0,5,0,0" Text="DK" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="PSU TYPE" />
                        <TextBox x:Name="PsuTypeTextBox" Margin="0,5,0,0" Text="personal" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="SERVICE" />
                        <TextBox x:Name="ServiceTextBox" Margin="0,5,0,0" Text="AIS" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="PAYMENT TYPE (OPTIONAL)" />
                        <TextBox x:Name="PaymentTypeTextBox" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>

                <Button x:Name="LoadDataButton"
                        Grid.Column="3"
                        Margin="14,19,0,0"
                        MinWidth="110"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="LoadDataButton_Click"
                        Content="Load JSON" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Raw API response" />
                        <TextBlock x:Name="SourceDescriptionTextBlock"
                                   Margin="0,3,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="Enable Banking application metadata." />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CopyJsonButton_Click"
                            Content="Copy JSON" />
                </Grid>
                <TextBox x:Name="RawJsonTextBox"
                         Grid.Row="2"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         FontFamily="Consolas"
                         FontSize="12"
                         VerticalContentAlignment="Top"
                         TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         Text="Choose a source and load data." />
            </Grid>
        </Border>
    </Grid>
</UserControl>
