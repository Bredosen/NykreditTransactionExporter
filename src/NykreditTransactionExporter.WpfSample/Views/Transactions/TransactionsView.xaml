<UserControl x:Class="NykreditTransactionExporter.WpfSample.Views.Transactions.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="ACCOUNT" />
                        <ComboBox x:Name="AccountComboBox"
                                  Margin="0,5,0,0"
                                  SelectionChanged="AccountComboBox_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="FROM" />
                        <DatePicker x:Name="DateFromPicker" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="TO" />
                        <DatePicker x:Name="DateToPicker" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="STATUS" />
                        <ComboBox x:Name="StatusComboBox" Margin="0,5,0,0">
                            <ComboBoxItem Content="Booked" Tag="BOOK" IsSelected="True" />
                            <ComboBoxItem Content="Pending" Tag="PDNG" />
                            <ComboBoxItem Content="Hold" Tag="HOLD" />
                            <ComboBoxItem Content="Scheduled" Tag="SCHD" />
                            <ComboBoxItem Content="Cancelled" Tag="CNCL" />
                            <ComboBoxItem Content="Rejected" Tag="RJCT" />
                            <ComboBoxItem Content="Other" Tag="OTHR" />
                        </ComboBox>
                    </StackPanel>
                    <Button x:Name="LoadTransactionsButton"
                            Grid.Column="8"
                            MinWidth="120"
                            Margin="0,19,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="LoadTransactionsButton_Click"
                            Content="Load data" />
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Fetch strategy" />
                    <ComboBox x:Name="StrategyComboBox" Grid.Column="1" Margin="8,0,0,0">
                        <ComboBoxItem Content="Default" Tag="default" IsSelected="True" />
                        <ComboBoxItem Content="Longest available" Tag="longest" />
                    </ComboBox>
                    <TextBlock Grid.Column="3"
                               VerticalAlignment="Center"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Loaded" />
                    <TextBlock x:Name="TransactionCountTextBlock"
                               Grid.Column="4"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="0 transactions" />
                    <Button x:Name="LoadTransactionDetailsButton"
                            Grid.Column="5"
                            Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="LoadTransactionDetailsButton_Click"
                            Content="Load selected details"
                            IsEnabled="False" />
                </Grid>

                <Expander Margin="0,12,0,0" Header="CSV export">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ExportMonthTextBox"
                                 Grid.Column="0"
                                 ToolTip="Month in yyyy-MM format" />
                        <TextBox x:Name="ExportPathTextBox"
                                 Grid.Column="2"
                                 ToolTip="Optional output path" />
                        <CheckBox x:Name="ExportAllAccountsCheckBox"
                                  Grid.Column="3"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center"
                                  Content="All accounts" />
                        <Button Grid.Column="4"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BrowseExportButton_Click"
                                Content="Browse..." />
                        <Button x:Name="ExportButton"
                                Grid.Column="5"
                                Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ExportButton_Click"
                                Content="Export CSV" />
                    </Grid>
                </Expander>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.75*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                <DataGrid x:Name="TransactionsDataGrid"
                          AutoGenerateColumns="False"
                          SelectionChanged="TransactionsDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="95" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" />
                        <DataGridTextColumn Header="Counterparty" Binding="{Binding Counterparty}" Width="1.2*" />
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="95" />
                        <DataGridTextColumn Header="Currency" Binding="{Binding Currency}" Width="72" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="75" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Transaction data" />
                    <TextBlock x:Name="SelectedTransactionTextBlock"
                               Grid.Row="1"
                               Margin="0,3,0,10"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Select a transaction to inspect its raw payload." />
                    <TextBox x:Name="TransactionJsonTextBox"
                             Grid.Row="2"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             FontFamily="Consolas"
                             FontSize="12"
                             VerticalContentAlignment="Top"
                         TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
